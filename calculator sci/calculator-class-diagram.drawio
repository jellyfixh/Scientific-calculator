<mxfile host="app.diagrams.net" modified="2026-11-02T02:20:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="local-calculator" name="เครื่องคิดเลขวิทยาศาสตร์">
    <mxGraphModel dx="1320" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t1" value="CLASS DIAGRAM — SCIENTIFIC CALCULATOR&#xa;โครงสร้างอ้างอิงจากโปรแกรมใน index.html" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Mali;fontSize=22;fontStyle=1;fontColor=#343247;" vertex="1" parent="1"><mxGeometry x="50" y="25" width="1180" height="70" as="geometry"/></mxCell>
        <mxCell id="Engine" value="&lt;div style=&quot;text-align:center;font-weight:bold&quot;&gt;ExpressionEngine&lt;/div&gt;&lt;hr&gt;&lt;div&gt;+ degrees: boolean&lt;br&gt;+ ans: number&lt;br&gt;+ second: boolean&lt;/div&gt;&lt;hr&gt;&lt;div&gt;+ tokenize(expression): string&lt;br&gt;+ evaluate(expression): number&lt;br&gt;+ fact(n): number&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;fillColor=#FCECF3;strokeColor=#D997B4;strokeWidth=1.5;fontColor=#343247;fontFamily=Mali;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="360" height="215" as="geometry"/></mxCell>
        <mxCell id="CalculatorView" value="&lt;div style=&quot;text-align:center;font-weight:bold&quot;&gt;CalculatorView&lt;/div&gt;&lt;hr&gt;&lt;div&gt;+ engine: ExpressionEngine&lt;br&gt;+ input: string&lt;br&gt;+ history: HistoryEntry[]&lt;br&gt;+ expr, out: HTMLElement&lt;/div&gt;&lt;hr&gt;&lt;div&gt;+ bind(): void&lt;br&gt;+ insert(value): void&lt;br&gt;+ action(action): void&lt;br&gt;+ calculate(): void&lt;br&gt;+ restore(): void&lt;br&gt;+ renderHistory(): void&lt;br&gt;+ clearHistory(): void&lt;br&gt;+ tab(name): void&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;fillColor=#DDEFE8;strokeColor=#8CB9A6;strokeWidth=1.5;fontColor=#343247;fontFamily=Mali;fontSize=14;" vertex="1" parent="1"><mxGeometry x="510" y="145" width="410" height="300" as="geometry"/></mxCell>
        <mxCell id="Stats" value="&lt;div style=&quot;text-align:center;font-weight:bold&quot;&gt;StatisticsPanel&lt;/div&gt;&lt;hr&gt;&lt;div&gt;+ calculate(): void&lt;br&gt;+ showError(message): void&lt;/div&gt;&lt;hr&gt;&lt;div&gt;คำนวณ mean, median, mode,&lt;br&gt;ส่วนเบี่ยงเบนมาตรฐาน, min, max&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingTop=7;fillColor=#F7F4FC;strokeColor=#B5A8D4;strokeWidth=1.5;fontColor=#343247;fontFamily=Mali;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="555" width="320" height="170" as="geometry"/></mxCell>
        <mxCell id="Graph" value="&lt;div style=&quot;text-align:center;font-weight:bold&quot;&gt;GraphPlotter&lt;/div&gt;&lt;hr&gt;&lt;div&gt;+ engine: ExpressionEngine&lt;br&gt;+ canvas: HTMLCanvasElement&lt;/div&gt;&lt;hr&gt;&lt;div&gt;+ plot(): void&lt;br&gt;+ evaluateAt(fn, x): number&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingTop=7;fillColor=#F7F4FC;strokeColor=#B5A8D4;strokeWidth=1.5;fontColor=#343247;fontFamily=Mali;fontSize=13;" vertex="1" parent="1"><mxGeometry x="510" y="555" width="350" height="170" as="geometry"/></mxCell>
        <mxCell id="UI" value="&lt;div style=&quot;text-align:center;font-weight:bold&quot;&gt;Browser UI / DOM&lt;/div&gt;&lt;hr&gt;&lt;div&gt;ปุ่ม, ช่องกรอก, แท็บ,&lt;br&gt;หน้าจอผลลัพธ์ และ canvas&lt;/div&gt;" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=9;fillColor=#FFF9E9;strokeColor=#D9C982;fontColor=#514A3E;fontFamily=Mali;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1030" y="175" width="240" height="135" as="geometry"/></mxCell>
        <mxCell id="Storage" value="&lt;div style=&quot;text-align:center;font-weight:bold&quot;&gt;localStorage&lt;/div&gt;&lt;hr&gt;&lt;div&gt;key: mali-history&lt;br&gt;เก็บประวัติเป็น JSON&lt;br&gt;{ input, result }[]&lt;/div&gt;" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF9E9;strokeColor=#D9C982;fontColor=#514A3E;fontFamily=Mali;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1010" y="555" width="260" height="145" as="geometry"/></mxCell>

        <mxCell id="e-view-engine" value="owns / creates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=diamond;startFill=1;endArrow=none;strokeColor=#8A7697;strokeWidth=1.5;fontFamily=Mali;fontSize=11;fontColor=#62536E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="CalculatorView" target="Engine"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-view-stats" value="creates on action" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#75669C;fontFamily=Mali;fontSize=11;fontColor=#62536E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="CalculatorView" target="Stats"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-view-graph" value="creates with engine" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#75669C;fontFamily=Mali;fontSize=11;fontColor=#62536E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="CalculatorView" target="Graph"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-graph-engine" value="uses for evaluation" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#8A7697;strokeWidth=1.4;fontFamily=Mali;fontSize=11;fontColor=#62536E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="Graph" target="Engine"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-view-ui" value="reads / updates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#B29D61;fontFamily=Mali;fontSize=11;fontColor=#62536E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="CalculatorView" target="UI"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-stats-ui" value="reads data / writes metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#B29D61;fontFamily=Mali;fontSize=10;fontColor=#62536E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="Stats" target="UI"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-graph-ui" value="draws function curve" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#B29D61;fontFamily=Mali;fontSize=10;fontColor=#62536E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="Graph" target="UI"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-view-storage" value="saves / restores history" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#B29D61;fontFamily=Mali;fontSize=10;fontColor=#62536E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="CalculatorView" target="Storage"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note-local" value="&lt;b&gt;ความสัมพันธ์&lt;/b&gt; — เพชรทึบ = owns/composition · เส้นประ = dependency หรือใช้บริการภายนอก&lt;br&gt;&lt;b&gt;ขอบเขต&lt;/b&gt; — ชื่อคลาสและเมธอดยึดตามโค้ดใน index.html; Browser UI และ localStorage เป็นส่วนที่คลาสเรียกใช้ ไม่ใช่คลาสที่ประกาศในโปรแกรม" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#F7F3FB;strokeColor=#DCD3F3;fontColor=#514A3E;fontFamily=Mali;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="770" width="1210" height="85" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="numerproject-reference" name="NumerProject อ้างอิง">
    <mxGraphModel dx="1320" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="rt" value="REFERENCE MODEL — NUMERPROJECT&#xa;แนวคิดโดเมนจากเอกสารโครงการและรายการวิธีคำนวณบนเว็บจริง" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Mali;fontSize=22;fontStyle=1;fontColor=#343247;" vertex="1" parent="1"><mxGeometry x="50" y="25" width="1200" height="70" as="geometry"/></mxCell>
        <mxCell id="Problem" value="&lt;div style=&quot;text-align:center;font-weight:bold&quot;&gt;&amp;laquo;abstract&amp;raquo;&lt;br&gt;Problem&lt;/div&gt;&lt;hr&gt;&lt;div&gt;# problemId: string&lt;br&gt;# userId: string&lt;br&gt;# detail: JSON&lt;br&gt;# problemType: string&lt;/div&gt;&lt;hr&gt;&lt;div&gt;+ getProblemId(mode)&lt;br&gt;+ setUserId(userId)&lt;br&gt;+ getInput()&lt;br&gt;+ formatInput() {abstract}&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingTop=7;fillColor=#FCECF3;strokeColor=#D997B4;strokeWidth=1.5;fontColor=#343247;fontFamily=Mali;fontSize=13;" vertex="1" parent="1"><mxGeometry x="65" y="155" width="380" height="235" as="geometry"/></mxCell>
        <mxCell id="ProblemSolver" value="&lt;div style=&quot;text-align:center;font-weight:bold&quot;&gt;&amp;laquo;abstract&amp;raquo;&lt;br&gt;ProblemSolver&lt;/div&gt;&lt;hr&gt;&lt;div&gt;# solverId: string&lt;br&gt;# userId: string&lt;br&gt;# detail: JSON&lt;br&gt;# solutionType: string&lt;br&gt;# problem: Problem&lt;/div&gt;&lt;hr&gt;&lt;div&gt;+ getOutput() {abstract}&lt;br&gt;+ setUserId(userId)&lt;br&gt;+ getProblemSolverId()&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingTop=7;fillColor=#DDEFE8;strokeColor=#8CB9A6;strokeWidth=1.5;fontColor=#343247;fontFamily=Mali;fontSize=13;" vertex="1" parent="1"><mxGeometry x="820" y="155" width="400" height="235" as="geometry"/></mxCell>
        <mxCell id="RootProblem" value="&lt;div style=&quot;text-align:center;font-weight:bold&quot;&gt;RootOfEquationProblem&lt;/div&gt;&lt;hr&gt;&lt;div&gt;extends Problem&lt;br&gt;รากสมการ&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;fillColor=#FFF8FB;strokeColor=#D997B4;fontColor=#343247;fontFamily=Mali;fontSize=12;" vertex="1" parent="1"><mxGeometry x="65" y="545" width="260" height="105" as="geometry"/></mxCell>
        <mxCell id="IntegrateProblem" value="&lt;div style=&quot;text-align:center;font-weight:bold&quot;&gt;IntegrateProblem&lt;/div&gt;&lt;hr&gt;&lt;div&gt;extends Problem&lt;br&gt;ปริพันธ์เชิงตัวเลข&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;fillColor=#FFF8FB;strokeColor=#D997B4;fontColor=#343247;fontFamily=Mali;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="545" width="260" height="105" as="geometry"/></mxCell>
        <mxCell id="TrapezoidalRuleSolver" value="&lt;div style=&quot;text-align:center;font-weight:bold&quot;&gt;TrapezoidalRuleSolver&lt;/div&gt;&lt;hr&gt;&lt;div&gt;extends ProblemSolver&lt;br&gt;Trapezoidal rule&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;fillColor=#F7F4FC;strokeColor=#B5A8D4;fontColor=#343247;fontFamily=Mali;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="545" width="245" height="105" as="geometry"/></mxCell>
        <mxCell id="NewtonSolver" value="&lt;div style=&quot;text-align:center;font-weight:bold&quot;&gt;NewtonDividedDifferenceSolver&lt;/div&gt;&lt;hr&gt;&lt;div&gt;extends ProblemSolver&lt;br&gt;Interpolation method&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;fillColor=#F7F4FC;strokeColor=#B5A8D4;fontColor=#343247;fontFamily=Mali;fontSize=12;" vertex="1" parent="1"><mxGeometry x="980" y="545" width="270" height="105" as="geometry"/></mxCell>
        <mxCell id="a-root" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=0;strokeColor=#75669C;strokeWidth=1.5;" edge="1" parent="1" source="RootProblem" target="Problem"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-integrate" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=0;strokeColor=#75669C;strokeWidth=1.5;" edge="1" parent="1" source="IntegrateProblem" target="Problem"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-trap" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=0;strokeColor=#75669C;strokeWidth=1.5;" edge="1" parent="1" source="TrapezoidalRuleSolver" target="ProblemSolver"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-newton" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=0;strokeColor=#75669C;strokeWidth=1.5;" edge="1" parent="1" source="NewtonSolver" target="ProblemSolver"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-compose" value="problem: Problem (1)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=diamond;startFill=1;endArrow=none;strokeColor=#8A7697;strokeWidth=1.5;fontFamily=Mali;fontSize=11;fontColor=#62536E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ProblemSolver" target="Problem"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ref-note" value="&lt;b&gt;UML class names&lt;/b&gt; RootOfEquationProblem, IntegrateProblem, TrapezoidalRuleSolver, NewtonDividedDifferenceSolver, Problem, ProblemSolver are described in the attached project document. The public README confirms the corresponding numerical method families, but does not expose every class detail.&lt;br&gt;&lt;br&gt;Website: https://numer.wilar.in.th/  |  Repository: https://github.com/tonkaew131/NumerProject" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#FFF9E9;strokeColor=#E6D89D;fontColor=#514A3E;fontFamily=Mali;fontSize=12;" vertex="1" parent="1"><mxGeometry x="65" y="720" width="1185" height="105" as="geometry"/></mxCell>
      </root>
